rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Firestore Security Rules — LeaveEasy
// สัปดาห์ที่ 7: กฎขั้นต่ำ — ต้องล็อกอินก่อนเท่านั้น ถึงจะอ่าน/เขียนได้
// ยังไม่แยกสิทธิ์ตามคนหรือ role (เช่น employee ห้ามดูใบลาคนอื่น) — ทำในสัปดาห์ที่ 8
// {document=**} ครอบคลุมทุกโฟลเดอร์ (users, leaveTypes, leaveRequests)
// รวมถึงโฟลเดอร์ย่อย approvals ของแต่ละใบลาด้วย
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
