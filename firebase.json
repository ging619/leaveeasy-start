{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      ".git/**",
      ".git",
      ".gitignore",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "*.md",
      ".claude/**",
      "docs/**",
      ".env",
      ".env.*",
      "*serviceAccountKey*.json",
      "*firebase-adminsdk*.json"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
